# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Data — keep the folder structure, not the contents
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep

# Model / run artifacts
reports/figures/*
reports/metrics/*
!reports/**/.gitkeep
!reports/evidence/
!reports/evidence/**
models/*.txt
models/*.pkl
mlruns/

# Rendered docs (generated from the .md sources)
docs/*.pdf

# Local-only working notes (kept out of version control)
docs/walkthrough.md

# Scratch / transient
tmp/

# OS / editor
.DS_Store
.idea/
.vscode/
*.ipynb_checkpoints
